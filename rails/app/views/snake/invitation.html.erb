<% content_for :title, "Join — Next Level Snake" %>
<% content_for :head do %>
  <link rel="stylesheet" href="/multiplayer/lobby.css?v=step11-responsive-34">
<% end %>

<div class="page-texture" aria-hidden="true"></div>
<div class="page-scrim" aria-hidden="true"></div>

<div class="spine" aria-hidden="true">
  <span>Next Level Snake <b>/</b> Join</span>
</div>

<header class="masthead">
  <div class="masthead__brand-group">
    <a class="masthead__brand masthead__brand--link" href="<%= root_path %>" aria-label="Next Level Snake — back to the main page">
      <span class="mark" aria-hidden="true"></span>
      <span class="brand__text">
        <span class="brand__eyebrow">Next Level</span>
        <span class="wordmark">Snake</span>
      </span>
    </a>
  </div>
</header>

<main class="band" id="join-root" data-code="<%= @invitation_code %>">
  <p class="mp-flash" id="join-flash" role="status" aria-live="polite" hidden></p>

  <% if @joinable %>
    <form class="mp-card join-sheet" id="join-form">
      <p class="mp-room__eyebrow">Room</p>
      <p class="mp-room__code"><%= @invitation_code %></p>
      <label class="auth-field">
        <span>Name</span>
        <input id="join-name" type="text" maxlength="30" minlength="2" autocomplete="nickname"
               placeholder="e.g. Ada" spellcheck="false" required>
      </label>
      <div class="mp-actions">
        <button class="btn btn--primary" id="join-go" type="submit">Join</button>
      </div>
    </form>
  <% else %>
    <article class="mp-card join-sheet">
      <p class="mp-room__eyebrow">Room</p>
      <p class="mp-room__code"><%= @invitation_code %></p>
      <p class="mp-card__hint">
        <% if @room&.full? %>
          That room is full.
        <% elsif @room&.closed? %>
          <%= @room.closed_reason_message %>
        <% elsif @room %>
          That room is not open for joining right now.
        <% else %>
          That code did not work.
        <% end %>
      </p>
    </article>
  <% end %>
</main>

<% content_for :scripts do %>
  <script src="/multiplayer/join.js?v=2.6"></script>
<% end %>
