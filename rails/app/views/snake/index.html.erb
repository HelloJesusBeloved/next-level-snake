<div class="page-texture" aria-hidden="true"></div>
<div class="page-scrim" aria-hidden="true"></div>
<canvas id="matrix-rain" class="matrix-rain" aria-hidden="true"></canvas>

<div class="spine" aria-hidden="true">
  <span>Next Level Snake <b>/</b> Wall-Wrap Arcade <b>/</b> Rails 8</span>
</div>

<header class="masthead">
  <div class="masthead__brand">
    <span class="mark" aria-hidden="true"></span>
    <span class="brand__text">
      <span class="brand__eyebrow">Next Level</span>
      <span class="wordmark">Snake</span>
    </span>
  </div>
  <nav class="masthead__meta" aria-label="Main navigation">
    <a class="btn btn--small btn--nav" href="#leaderboard">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M6 2h12v2h4v4a5 5 0 0 1-5 5h-.5A6 6 0 0 1 13 15.9V18h3v4H8v-4h3v-2.1A6 6 0 0 1 7.5 13H7a5 5 0 0 1-5-5V4h4V2Zm-2 4v1a3 3 0 0 0 3 3V6H4Zm16 0h-3v4a3 3 0 0 0 3-3V6Z" /></svg>
      Leaderboard
    </a>
    <a class="btn btn--small btn--nav" href="#manual">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm1 3h2V5H5v1Zm0 2h2V7H5v1Zm12-3h-2v1h2V5Zm0 3h-2V7h2v1ZM4 12h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1Zm1 3h2v-1H5v1Zm0 2h2v-1H5v1Zm12-3h-2v1h2v-1Zm0 3h-2v-1h2v1Z" /></svg>
      Self Host
    </a>
    <a class="btn btn--small btn--nav" href="/profile">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" shapeRendering="crispEdges" aria-hidden="true"><path d="M2 8h20v3H2Zm1 3h6v5H3v-5Zm13 0h6v5h-6v-5Z" /></svg>
      Profile
    </a>
    <span class="auth-area" id="auth-out">
      <button class="btn btn--small" id="btn-open-login" type="button">Sign in</button>
      <button class="btn btn--small btn--primary" id="btn-open-create" type="button">Create account</button>
    </span>
