<main class="shell">
  <section class="stage">
    <div class="stage__head">
      <p class="stage__eyebrow">01 — The game</p>
      <h1 class="stage__title">Beautiful.<br>Modern.<br><em>Snake.</em></h1>
      <p class="stage__sub">
        One long green body, a red box of food, and walls that wrap instead of
        ending the run. Preset or fully custom speed and growth, seven cabinet
        skins, per-combination records — and signed-in players fighting over the
        hall.
      </p>
    </div>

    <div class="hud" id="hud" aria-label="Current run">
            <div class="hud__cell">
              <span class="hud__label">Score</span>
              <span class="hud__value hud__value--score" data-live-score>0</span>
            </div>
            <div class="hud__cell">
              <span class="hud__label">Best</span>
              <span class="hud__value" data-live-best>—</span>
            </div>
            <div class="hud__cell hud__cell--mode">
              <span class="hud__label">Mode</span>
              <span class="hud__mode" data-live-mode>Normal · ×1</span>
            </div>
          </div>

          <div class="hud-float" id="hud-float" aria-label="Current game score">
            <span class="hud-float__label">Score</span>
            <b data-live-score>0</b>
          </div>

    <div class="screen">
      <div id="snake-root"></div>

      <div class="overlay is-visible" id="overlay">
        <div class="panel is-visible" id="panel-start">
          <p class="panel__eyebrow">Ready</p>
          <h2 class="panel__title">Press a direction to start</h2>
          <p class="panel__body">
            <kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> or the arrow keys on
            desktop — swipe anywhere on the page while playing. Drive through a
            wall and you come out the other side.
          </p>
          <div class="panel__actions">
            <button class="btn btn--primary" id="btn-start" type="button">Start game</button>
          </div>
        </div>

        <div class="panel" id="panel-pause">
          <p class="panel__eyebrow">Held</p>
          <h2 class="panel__title">Paused</h2>
          <dl class="mods" style="margin-bottom:16px">
            <div>
              <dt>Speed</dt>
              <dd id="pause-speed">Normal · 105 ms / step</dd>
            </div>
            <div>
              <dt>Growth</dt>
              <dd id="pause-growth">×1 blocks per food</dd>
            </div>
          </dl>
          <p class="panel__body">
            You can scroll while paused. Modifiers stay locked for this run.
            Press <kbd>P</kbd> or <kbd>Esc</kbd> to resume and lock the page again.
          </p>
          <div class="panel__actions">
            <button class="btn btn--primary" id="btn-resume" type="button">Resume</button>
            <button class="btn" id="btn-quit" type="button">Quit run</button>
          </div>
        </div>

        <div class="panel result-panel" id="panel-over">
                <div class="result-heading">
                  <div>
                    <p class="panel__eyebrow">Run complete</p>
                    <h2 class="panel__title">Game over</h2>
                  </div>
                  <p class="final">
                    <span class="final__label">Final score</span>
                    <span class="final__value" id="final-score">0</span>
                  </p>
                </div>
                <dl class="mods result-mods">
            <div>
              <dt>Speed</dt>
              <dd id="final-speed">Normal · 105 ms / step</dd>
            </div>
            <div>
              <dt>Growth</dt>
              <dd id="final-growth">×1 blocks per food</dd>
            </div>
            <div>
              <dt>Best here</dt>
              <dd id="final-best">—</dd>
            </div>
          </dl>
          <p class="flag" id="final-flag" hidden>New best for this mode</p>
          <div class="save-note" id="final-save" hidden>
            <p id="final-save-text"></p>
            <div class="panel__actions" id="final-save-actions">
              <button class="btn btn--small btn--primary" id="btn-final-signin" type="button">Sign in</button>
              <button class="btn btn--small" id="btn-final-create" type="button">Create account</button>
            </div>
          </div>
          <div class="panel__actions">
            <button class="btn btn--primary" id="btn-again" type="button">Play again</button>
            <button class="btn" id="btn-quit-over" type="button">Quit</button>
          </div>
        </div>
      </div>
    </div>

    <div class="pausebar">
      <button class="btn" id="pause-btn" type="button">Pause</button>
    </div>
  </section>

  <aside class="rail">
          <div class="score-stack">
            <div class="card card--score" id="scoreboard">
            <div class="card__head">
              <h2 class="card__title">Scoreboard</h2>
              <span class="mode-chip" data-live-mode>Normal · ×1</span>
            </div>
            <div class="stat-tiles">
              <div class="stat">
                <span class="stat__label">Score</span>
                <span class="stat__value stat__value--live" id="current-score" data-live-score>0</span>
              </div>
              <div class="stat">
                <span class="stat__label">Best</span>
                <span class="stat__value" id="best-score" data-live-best>—</span>
              </div>
            </div>
            <p class="stat-line" id="mode-stats">No runs in this mode yet</p>
            <h3 class="mini-title">Recent runs <span>this device</span></h3>
            <ol class="runs" id="recent-runs" aria-label="Recent runs">
              <li class="runs__empty">Play a run and it shows up here.</li>
            </ol>
          </div>

            <div class="card" id="controls-card">
      <div class="card__head">
        <h2 class="card__title">Controls</h2>
      </div>
      <div class="keys">
        <div class="keys__row">
          <span>Steer</span>
          <span><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd> · <kbd>↑</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd></span>
        </div>
        <div class="keys__row">
          <span>Start</span>
          <span><kbd>Space</kbd> <kbd>Enter</kbd></span>
        </div>
        <div class="keys__row">
          <span>Pause</span>
          <span><kbd>P</kbd> <kbd>Esc</kbd></span>
        </div>
        <div class="keys__row">
          <span>Touch</span>
          <span>Swipe</span>
        </div>
      </div>
    </div>
          </div>

          <div class="card" id="settings-card">
      <div class="card__head">
        <h2 class="card__title">Modifiers</h2>
        <span class="lock-badge" id="settings-lock" hidden>In play — locked</span>
      </div>

      <div class="setting">
        <div class="setting__head">
          <h3>Cabinet skin</h3>
          <span class="setting__value" id="theme-value">Arcade</span>
        </div>
        <div class="segmented" id="settings-theme" role="group" aria-label="Cabinet skin">
          <button type="button" data-theme="arcade" aria-pressed="true">
            <span class="swatch" data-swatch="arcade"><i aria-hidden="true"></i>Arcade</span>
          </button>
          <button type="button" data-theme="classic" aria-pressed="false">
            <span class="swatch" data-swatch="classic"><i aria-hidden="true"></i>Classic</span>
          </button>
          <button type="button" data-theme="vintage" aria-pressed="false">
            <span class="swatch" data-swatch="vintage"><i aria-hidden="true"></i>Vintage</span>
          </button>
          <button type="button" data-theme="terminal" aria-pressed="false">
            <span class="swatch" data-swatch="terminal"><i aria-hidden="true"></i>Terminal</span>
          </button>
          <button type="button" data-theme="paper" aria-pressed="false">
            <span class="swatch" data-swatch="paper"><i aria-hidden="true"></i>Paper</span>
          </button>
          <button type="button" data-theme="violet" aria-pressed="false">
            <span class="swatch" data-swatch="violet"><i aria-hidden="true"></i>Violet</span>
          </button>
          <button type="button" data-theme="sunsetfire" aria-pressed="false">
            <span class="swatch" data-swatch="sunsetfire"><i aria-hidden="true"></i>Royal Sunset</span>
          </button>
        </div>
        <p class="setting__hint">
          Arcade wraps the screen in an animated cabinet. Classic and Vintage use
          square blocks — Classic's merge into one smooth body. Violet sits on
          still mist; Terminal rains code behind the page, never inside the box.
        </p>
      </div>

      <div class="setting">
        <div class="setting__head">
          <h3>Snake speed</h3>
          <span class="setting__value" id="speed-value">Normal · 105 ms</span>
        </div>
        <div class="segmented" id="settings-speed" role="group" aria-label="Snake speed">
          <% SnakeHelper::SPEED_LEVELS.each do |level| %>
            <button type="button" data-speed="<%= level[:id] %>" aria-pressed="<%= level[:id] == 3 %>"><%= level[:label] %></button>
          <% end %>
          <button type="button" data-speed="custom" aria-pressed="false">Custom</button>
        </div>
        <div class="custom-row" id="custom-speed-row" hidden>
          <label class="range">
            <input type="range" id="custom-speed" min="0" max="100" step="1" value="42" aria-label="Custom snake speed in milliseconds per step">
            <span class="range-val" id="custom-speed-val">42 ms/step</span>
          </label>
        </div>
      </div>

      <div class="setting">
        <div class="setting__head">
          <h3>Growth per food</h3>
          <span class="setting__value" id="growth-value">×1 per food</span>
        </div>
        <div class="segmented" id="settings-growth" role="group" aria-label="Growth per food">
          <% (1..5).each do |n| %>
            <button type="button" data-growth="<%= n %>" aria-pressed="<%= n == 1 %>">×<%= n %></button>
          <% end %>
          <button type="button" data-growth="custom" aria-pressed="false">Custom</button>
        </div>
        <div class="custom-row" id="custom-growth-row" hidden>
          <label class="range">
            <input type="range" id="custom-growth" min="0" max="100" step="1" value="2" aria-label="Custom growth in blocks per food">
            <span class="range-val" id="custom-growth-val">×2 per food</span>
          </label>
        </div>
      </div>

    </div>
        </aside>
</main>

<section class="band" id="leaderboard">
        <p class="band__eyebrow">02 — The leaderboard</p>
        <h2 class="band__title">One game. Two boards. Everyone watching.</h2>
        <p class="band__lede">
          Signed-in players only. Standard ranks preset modifiers; Custom ranks
          any run that used a custom slider. Each player appears once per
          modifier combination with their best run, so use the filters to see
          exactly the speed and growth you care about. Guests can play, but
          their runs are not saved unless they sign in.
        </p>

        <div class="lb" id="lb">
          <div class="lb__tabs" role="tablist" aria-label="Leaderboard">
            <button class="lb__tab is-active" id="lb-tab-standard" role="tab" aria-selected="true" data-board="standard" type="button">
              <span class="lb__tab-name">Standard</span>
              <span class="lb__tab-sub">Preset modifiers</span>
            </button>
            <button class="lb__tab" id="lb-tab-custom" role="tab" aria-selected="false" data-board="custom" type="button">
              <span class="lb__tab-name">Custom</span>
              <span class="lb__tab-sub">Your own sliders</span>
            </button>
          </div>

          <div class="lb__filters" id="lb-filters">
            <div class="lb-filter">
              <span class="lb-filter__label">Speed</span>
              <div class="lb-filter__chips" id="filter-speed"></div>
            </div>
            <div class="lb-filter">
              <span class="lb-filter__label">Growth</span>
              <div class="lb-filter__chips" id="filter-growth"></div>
            </div>
            <div class="lb__actions">
              <button class="btn btn--small" id="filter-mine" type="button">Match my settings</button>
              <button class="btn btn--small" id="filter-reset" type="button">Reset filters</button>
            </div>
          </div>

          <p class="lb__status" id="lb-status" aria-live="polite">Loading the board…</p>

          <div class="lb__scroll">
            <table class="records lb__table">
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Player</th>
                  <th scope="col">Speed</th>
                  <th scope="col">Growth</th>
                  <th scope="col">Score</th>
                  <th scope="col">Set</th>
                </tr>
              </thead>
              <tbody id="board-body">
                <tr class="empty"><td colspan="6">Loading the board…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="band band--manual" id="manual">
  <p class="band__eyebrow">03 — Self-hosting · Podman first</p>
  <h2 class="band__title">One container. Two commands. Yours.</h2>
  <p class="band__lede">
    Run the Rails app and PostgreSQL directly with <code>podman compose up --build -d</code>
    from the repository root. No helper script. Prefer Docker? Use
    <code>docker compose up --build -d</code> with the same file. Fedora keeps
    SELinux enforcing: database storage has a private <code>:Z</code> label,
    and application files are built into the image.
  </p>

  <div class="manual-grid">
    <ol class="steps">
      <li>
        <div>
          <h3>Bring it up</h3>
          <p>Builds the image and starts PostgreSQL with persistent, SELinux-labeled storage.</p>
          <pre class="code"><code>git clone https://github.com/your-org/snake.git
cd snake
cp .env.example .env
# Set SECRET_KEY_BASE in .env to this generated value:
openssl rand -hex 64
podman compose up --build -d
open http://localhost:3000</code></pre>
        </div>
      </li>
      <li>
        <div>
          <h3>Configure it</h3>
          <p>The whole surface is <code>.env</code> at the repo root — port, secret, database credentials. Restart after editing: <code>podman compose up -d --force-recreate</code>.</p>
          <pre class="code"><code># .env
SECRET_KEY_BASE=&lt;openssl rand -hex 64&gt;
PORT=3000
DATABASE_USER=snake
DATABASE_PASSWORD=snake
DATABASE_NAME=snake_production
RAILS_LOG_LEVEL=info</code></pre>
        </div>
      </li>
      <li>
        <div>
          <h3>Operate it</h3>
          <p>Logs, a console, backups — all one line each, engine-agnostic.</p>
          <pre class="code"><code>podman compose logs -f app
podman compose exec app bin/rails console
podman compose exec db pg_dump -U snake snake_production &gt; snake.sql</code></pre>
        </div>
      </li>
      <li>
        <div>
          <h3>No containers? Bare metal</h3>
          <p>On Fedora or Ubuntu, <code>install.sh</code> detects the distro, installs mise, compiles the pinned Ruby and wires up systemd.</p>
          <pre class="code"><code>chmod +x install.sh
sudo ./install.sh
systemctl status snake</code></pre>
        </div>
      </li>
    </ol>

    <div>
      <div class="callout">
        <h3>The compose surface</h3>
        <ul>
          <li><code>app</code> — builds the Rails image, exposes <code>$PORT</code> → 3000, healthchecks <code>/up</code>.</li>
          <li><code>db</code> — <code>postgres:16-alpine</code>, role and database created from your <code>.env</code> values.</li>
          <li><code>pgdata</code> — named volume; <code>podman compose down</code> keeps it, <code>down -v</code> wipes it.</li>
          <li>Fedora: <code>pgdata:/var/lib/postgresql/data:Z</code> gives the database a private SELinux label. No privileged mode or disabled security labels.</li>
        </ul>
      </div>

      <pre class="code"><code># compose.yaml — read by both Podman and Docker compose
services:
  app:
    build: { context: . }
    image: next-level-snake:local
    networks: [snakenet]
    ports: ["${PORT:-3000}:3000"]
    environment:
      SECRET_KEY_BASE: ${SECRET_KEY_BASE}
      DATABASE_HOST: db
      DATABASE_USER: ${DATABASE_USER:-snake}
      DATABASE_PASSWORD: ${DATABASE_PASSWORD:-snake}
      DATABASE_NAME: ${DATABASE_NAME:-snake_production}
    depends_on:
      db: { condition: service_healthy }
  db:
    image: docker.io/library/postgres:16-alpine
    networks: [snakenet]
    environment:
      POSTGRES_USER: ${DATABASE_USER:-snake}
      POSTGRES_PASSWORD: ${DATABASE_PASSWORD:-snake}
      POSTGRES_DB: ${DATABASE_NAME:-snake_production}
    volumes: ["pgdata:/var/lib/postgresql/data:Z"]
networks:
  snakenet:
volumes:
  pgdata:</code></pre>
    </div>
  </div>
</section>

<footer class="footer">
  <span>Next Level Snake — wall-wrap arcade</span>
  <span>Ruby on Rails <%= Rails.version %> · PostgreSQL · Puma · Podman/Docker</span>
  <span>Scores isolated per speed × growth</span>
</footer>

<dialog class="dialog" id="auth-dialog" aria-labelledby="auth-title">
  <div class="dialog__inner">
    <div class="dialog__head">
      <h2 class="dialog__title" id="auth-title">Your name on the board</h2>
      <button class="dialog__close" id="auth-close" type="button" aria-label="Close">✕</button>
    </div>

    <div class="auth-tabs" role="tablist" aria-label="Login or create account">
      <button class="auth-tab" id="auth-tab-login" role="tab" aria-selected="true" type="button">Sign in</button>
      <button class="auth-tab" id="auth-tab-create" role="tab" aria-selected="false" type="button">Create account</button>
    </div>

    <form class="auth-form" id="form-login" autocomplete="off">
      <label class="auth-field">
        <span>Username</span>
        <input name="username" type="text" autocomplete="username" required minlength="2" maxlength="30">
      </label>
      <label class="auth-field">
        <span>Password</span>
        <input name="password" type="password" autocomplete="current-password" required minlength="8">
      </label>
      <p class="auth-error" id="auth-error-login" aria-live="polite"></p>
      <button class="btn btn--primary" type="submit">Sign in</button>
    </form>

    <form class="auth-form" id="form-create" autocomplete="off" hidden>
      <label class="auth-field">
        <span>Username</span>
        <input name="username" type="text" autocomplete="username" required minlength="2" maxlength="30">
      </label>
      <label class="auth-field">
        <span>Password</span>
        <input name="password" type="password" autocomplete="new-password" required minlength="8">
      </label>
      <label class="auth-field">
        <span>Confirm password</span>
        <input name="confirm-password" type="password" autocomplete="new-password" required minlength="8">
      </label>
      <div class="auth-warning" role="note">
        <p>
          An email is not required to make an account. However, this means that
          you will not be able to reset your password if you forget it. Please
          store your password in a safe place. I would highly recomend using a
          password manager, just in general. I use
          <a href="https://proton.me/pass" target="_blank" rel="noreferrer">Proton Pass</a>
          and really like and recomend it.
        </p>
      </div>
      <p class="auth-error" id="auth-error-create" aria-live="polite"></p>
      <button class="btn btn--primary" type="submit">Create account</button>
    </form>
  </div>
</dialog>
