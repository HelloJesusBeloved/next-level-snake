<% content_for :title, "Multiplayer — Next Level Snake" %>
<% content_for :head do %>
  <%# Lobby styling lives beside the lobby module, not in the single-player
      stylesheet, so the two pages stay independent. %>
  <link rel="stylesheet" href="/multiplayer/lobby.css?v=step10-mobile4">
<% end %>

<div class="page-texture" aria-hidden="true"></div>
<div class="page-scrim" aria-hidden="true"></div>
<canvas id="matrix-rain" class="matrix-rain" aria-hidden="true"></canvas>

<div class="spine" aria-hidden="true">
  <span>Next Level Snake <b>/</b> Multiplayer</span>
</div>

<header class="masthead">
  <div class="masthead__brand-group">
    <%# The wordmark always goes back to the main page. %>
    <a class="masthead__brand masthead__brand--link" href="<%= root_path %>" aria-label="Next Level Snake — back to the main page">
      <span class="mark" aria-hidden="true"></span>
      <span class="brand__text">
        <span class="brand__eyebrow">Next Level</span>
        <span class="wordmark">Snake</span>
      </span>
    </a>
    <div class="masthead__auth" id="mp-header-auth" aria-label="Account">
      <button class="btn btn--small" id="mp-signin-top" type="button">Sign in</button>
      <button class="btn btn--small" id="mp-create-top" type="button">Create account</button>
    </div>
    <span class="brand__credit">Made almost entirely with <a href="https://arena.ai" target="_blank" rel="noreferrer">arena.ai</a> ❤️</span>
  </div>
  <nav class="masthead__meta" aria-label="Main navigation">
    <a class="btn btn--small btn--nav" href="<%= root_path %>">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7L8 5Z" /></svg>
      Single Player
    </a>
    <a class="btn btn--small btn--nav" href="<%= root_path(anchor: "leaderboard") %>">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M6 2h12v2h4v4a5 5 0 0 1-5 5h-.5A6 6 0 0 1 13 15.9V18h3v4H8v-4h3v-2.1A6 6 0 0 1 7.5 13H7a5 5 0 0 1-5-5V4h4V2Zm-2 4v1a3 3 0 0 0 3 3V6H4Zm16 0h-3v4a3 3 0 0 0 3-3V6Z" /></svg>
      Leaderboard
    </a>
    <a class="btn btn--small btn--nav" href="<%= root_path(anchor: "manual") %>">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4 3h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm1 3h2V5H5v1Zm0 2h2V7H5v1Zm12-3h-2v1h2V5Zm0 3h-2V7h2v1ZM4 12h16a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1Zm1 3h2v-1H5v1Zm0 2h2v-1H5v1Zm12-3h-2v1h2v-1Zm0 3h-2v-1h2v1Z" /></svg>
      Self Host
    </a>
    <a class="btn btn--small btn--nav" href="<%= profile_path %>">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M2 8h20v3H2Zm1 3h6v5H3v-5Zm13 0h6v5h-6v-5Z" /></svg>
      Profile
    </a>
    <a class="btn btn--small btn--nav" href="https://github.com/HelloJesusBeloved/next-level-snake" target="_blank" rel="noreferrer">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.28-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.22.69.83.57A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12Z" /></svg>
      Open Source
    </a>
  </nav>
</header>

<main class="band" id="multiplayer-root" aria-labelledby="multiplayer-title"
      data-room-code="<%= @invitation_code %>"
      data-poll-interval="<%= Rails.application.config.x.multiplayer.poll_interval %>">
  <p class="band__eyebrow">A new way to play</p>
  <h1 class="band__title" id="multiplayer-title">Multiplayer</h1>
  <p class="band__lede" style="color: var(--text)">
    Open a room, share the code, and gather your friends. Brawls are played here once the
    match engine lands — the lobby itself is live.
  </p>

  <%# Same segmented control and swatches as the game page settings. %>
  <div class="segmented mp-themes" id="mp-themes" role="group" aria-label="Theme">
    <button type="button" data-theme="classic" aria-pressed="false">
      <span class="swatch" data-swatch="classic"><i aria-hidden="true"></i>Classic</span>
    </button>
    <button type="button" data-theme="arcade" aria-pressed="false">
      <span class="swatch" data-swatch="arcade"><i aria-hidden="true"></i>Arcade</span>
    </button>
    <button type="button" data-theme="vintage" aria-pressed="false">
      <span class="swatch" data-swatch="vintage"><i aria-hidden="true"></i>Vintage</span>
    </button>
    <button type="button" data-theme="terminal" aria-pressed="false">
      <span class="swatch" data-swatch="terminal"><i aria-hidden="true"></i>Terminal</span>
    </button>
    <button type="button" data-theme="paper" aria-pressed="false">
      <span class="swatch" data-swatch="paper"><i aria-hidden="true"></i>Paper</span>
    </button>
    <button type="button" data-theme="violet" aria-pressed="false">
      <span class="swatch" data-swatch="violet"><i aria-hidden="true"></i>Midnight Violet</span>
    </button>
    <button type="button" data-theme="sunsetfire" aria-pressed="false">
      <span class="swatch" data-swatch="sunsetfire"><i aria-hidden="true"></i>Royal Sunset</span>
    </button>
  </div>

  <noscript>
    <p class="mp-note mp-note--warn">Multiplayer rooms need JavaScript. Single Player works without it.</p>
  </noscript>

  <p class="mp-flash" id="mp-flash" role="status" aria-live="polite" hidden></p>

  <%# ---- not in a room ------------------------------------------------- %>
  <section class="mp-grid" id="mp-entry" hidden>
    <article class="mp-card">
      <h2 class="mp-card__title">Play as</h2>
      <p class="mp-card__hint" id="mp-identity-note">Guests can play straight away — no account needed.</p>
      <label class="auth-field">
        <span>Display name</span>
        <input id="mp-name" type="text" maxlength="30" minlength="2" autocomplete="nickname"
               placeholder="e.g. Ada" spellcheck="false">
      </label>
      <p class="mp-card__hint">Used in this room only. Your account name never changes.</p>
      <div class="mp-actions" id="mp-auth-actions">
        <button class="btn btn--small" id="mp-signin" type="button">Sign in</button>
        <button class="btn btn--small" id="mp-create-account" type="button">Create account</button>
      </div>
    </article>

    <article class="mp-card">
      <h2 class="mp-card__title">Start a room</h2>
      <p class="mp-card__hint">You become the host <span class="mp-crown" aria-hidden="true">👑</span> and get an invitation code to share. No size to pick — rooms expand as friends pile in.</p>
      <div class="mp-actions">
        <button class="btn btn--primary" id="mp-create" type="button">Create room</button>
      </div>
    </article>

    <article class="mp-card">
      <h2 class="mp-card__title">Join a room</h2>
      <p class="mp-card__hint">Enter the code a friend shared, or open their invitation link.</p>
      <label class="auth-field">
        <span>Invitation code</span>
        <input id="mp-code" type="text" maxlength="20" autocapitalize="characters" autocorrect="off"
               spellcheck="false" placeholder="ABCD-EFGH-JKMN" value="<%= @invitation_code %>">
      </label>
      <p class="mp-card__hint" id="mp-code-preview" hidden></p>
      <div class="mp-actions">
        <button class="btn btn--primary" id="mp-join" type="button">Join with Code</button>
        <button class="btn" id="mp-scan-open" type="button">
          <svg class="nav-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M3 12h18" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Scan QR Code
        </button>
      </div>
    </article>
  </section>

  <%# ---- inside a room ---------------------------------------------------- %>
  <section class="mp-room" id="mp-room" hidden>
    <header class="mp-room__head mp-share" aria-label="Share this room">
      <div class="mp-share__ident">
        <p class="mp-room__eyebrow">Brawl lobby · <span id="mp-room-state">lobby</span></p>
        <h2 class="mp-room__code" id="mp-room-code">————————————</h2>
        <p class="mp-share__url">
          <span class="mp-share__label">Invitation link</span>
          <code class="mp-share__link" id="mp-invite-url"></code>
        </p>
      </div>
      <div class="mp-share__panel">
        <div class="mp-share__buttons">
          <button class="btn btn--small btn--primary" id="mp-share-room" type="button" hidden>Share Room</button>
          <button class="btn btn--small" id="mp-copy-link" type="button">Copy Link</button>
          <button class="btn btn--small" id="mp-copy-code" type="button">Copy code</button>
          <button class="btn btn--small" id="mp-qr-toggle" type="button" aria-expanded="false" aria-controls="mp-qr">Show QR</button>
          <button class="btn btn--small" id="mp-scan-open-room" type="button">Scan QR Code</button>
        </div>
        <p class="mp-share__feedback" id="mp-share-feedback" role="status" aria-live="polite"></p>
        <div class="mp-qr" id="mp-qr" hidden>
          <canvas id="mp-qr-canvas" role="img" aria-label="QR code for this room's invitation link"></canvas>
          <p class="mp-qr__caption">Scan with a camera to open this invitation on another device.</p>
        </div>
      </div>
    </header>

    <p class="mp-room__meta">
      <span class="mp-conn" id="mp-conn" data-state="idle" role="status" aria-live="polite">
        <span class="mp-dot" aria-hidden="true"></span>
        <span id="mp-conn-text">Connecting…</span>
      </span>
      <span id="mp-count">0 players</span>
      <span aria-hidden="true">·</span>
      <span id="mp-ready-count">0 ready</span>
      <span aria-hidden="true">·</span>
      <span id="mp-start-state">Waiting for players</span>
    </p>

    <%# Dedicated multiplayer canvas: it paints only authoritative MatchChannel snapshots. %>
    <section class="mp-game" id="mp-game" hidden aria-label="Live Brawl">
      <div class="mp-game__heading">
        <div>
          <p class="mp-room__eyebrow">Server-authoritative Brawl</p>
          <p class="mp-game__status" id="mp-game-status" role="status" aria-live="off">Waiting for the simulation…</p>
        </div>
        <span class="mp-game__tick" id="mp-game-tick" aria-live="off"></span>
      </div>
      <%# Step 10: non-blocking connection state for THIS player's snake. The
          rest of the board keeps running for everyone else. %>
      <p class="mp-brawl-conn" id="mp-brawl-conn" data-state="live" role="status" aria-live="polite">
        <span class="mp-brawl-conn__ring" aria-hidden="true"></span>
        <span id="mp-brawl-conn-text">Live</span>
      </p>
      <nav class="mp-game-tabs" id="mp-game-tabs" aria-label="Brawl views">
        <button type="button" data-game-pane="board" aria-pressed="true">Board</button>
        <button type="button" data-game-pane="standings" aria-pressed="false">Standings</button>
        <button type="button" data-game-pane="lobby" aria-pressed="false">Lobby</button>
      </nav>
      <p class="mp-game__follow-row" id="mp-follow-row" hidden>
        <label for="mp-follow">Spectate</label>
        <select id="mp-follow" aria-label="Follow a living player"></select>
      </p>
      <div id="mp-board-pane">
        <canvas id="mp-game-canvas" class="mp-game__canvas" tabindex="0" role="application"
                aria-label="Multiplayer Snake arena. Use arrow keys or WASD, swipe the arena, or use the direction buttons."></canvas>
        <ol class="mp-game-scores" id="mp-game-scores" aria-label="Brawl standings"></ol>
      </div>
      <div id="mp-standings-pane" hidden>
        <div id="mp-standings-table"></div>
      </div>
      <section class="mp-results" id="mp-results" hidden aria-label="Final results">
        <h4 class="mp-results__title">Final results</h4>
        <div id="mp-results-table"></div>
      </section>
      <div class="mp-eliminated" id="mp-eliminated" hidden role="alertdialog" aria-labelledby="mp-eliminated-title" aria-describedby="mp-eliminated-score">
        <p class="mp-room__eyebrow">Eliminated</p>
        <h4 class="mp-eliminated__title" id="mp-eliminated-title"><span id="mp-eliminated-name">Your snake</span> is out</h4>
        <p class="mp-eliminated__score" id="mp-eliminated-score"></p>
        <div class="mp-actions">
          <button class="btn btn--primary btn--small" id="mp-spectate" type="button">Spectate Brawl</button>
          <button class="btn btn--small" id="mp-lobby-view" type="button">Return to Lobby</button>
          <button class="btn btn--small" id="mp-duel-entry" type="button" disabled title="Duels arrive in a later step">Duel (soon)</button>
        </div>
      </div>
      <nav class="mp-game-controls" aria-label="Touch steering">
        <button type="button" data-game-dir="up" aria-label="Steer up">↑</button>
        <div>
          <button type="button" data-game-dir="left" aria-label="Steer left">←</button>
          <button type="button" data-game-dir="down" aria-label="Steer down">↓</button>
          <button type="button" data-game-dir="right" aria-label="Steer right">→</button>
        </div>
      </nav>
      <p class="mp-game__hint">Keyboard: arrows / WASD. Touch: swipe or use the steering pad. Only your direction is sent; positions, food and scores come from the server.</p>
      <p class="mp-game__input-status" id="mp-game-input-status" role="status" aria-live="polite"></p>
      <details class="mp-movement-diagnostics" id="mp-movement-diagnostics">
        <summary>Movement diagnostics</summary>
        <label><input type="checkbox" id="mp-movement-pacing"> Smooth uneven delivery (adds latency)</label>
        <p>Off by default for the lowest receive-to-paint delay. If the connection is uneven,
          opt in to hold complete server frames up to 50 ms (or half a tick) plus a display
          refresh. This trades responsiveness for more even spacing. No snake cells are invented;
          turns, elimination, freeze and results still bypass the hold.</p>
        <pre id="mp-movement-metrics" aria-live="off">Open during a match to measure server, network and drawing intervals.</pre>
      </details>
    </section>

    <p class="mp-game__follow-row" id="mp-back-to-board-row" hidden>
      <button class="btn btn--small" id="mp-board-view" type="button">Back to Board</button>
    </p>

    <ul class="mp-roster" id="mp-roster" aria-label="Players in this room"></ul>

    <div class="mp-config-grid">
      <section class="mp-card mp-color-card" aria-labelledby="mp-color-title">
        <p class="mp-room__eyebrow">Your multiplayer identity</p>
        <h3 class="mp-card__title" id="mp-color-title">Choose your color</h3>
        <p class="mp-my-color" id="mp-my-color"></p>
        <div class="mp-color-options" id="mp-color-options" role="group" aria-label="Player colors"></div>
        <p class="mp-card__hint" id="mp-color-note"></p>
        <p class="mp-config-status" id="mp-color-status" role="status" aria-live="polite"></p>
      </section>
      <section class="mp-card mp-board-card" aria-labelledby="mp-board-title">
        <p class="mp-room__eyebrow" id="mp-board-host-label">Host controls · next Brawl</p>
        <h3 class="mp-card__title" id="mp-board-title">Brawl board <span id="mp-board-current">24 × 18</span></h3>
        <p class="mp-card__hint" id="mp-board-reason" role="status" aria-live="polite"></p>
        <p class="mp-card__hint" id="mp-board-recommendation"></p>
        <form id="mp-board-form" class="mp-board-form">
          <label for="mp-board-preset">Size preset</label>
          <select id="mp-board-preset" disabled></select>
          <div class="mp-board-dimensions">
            <label for="mp-board-columns">Columns <input id="mp-board-columns" type="number" min="24" max="96" step="1" value="24" required disabled></label>
            <label for="mp-board-rows">Rows <input id="mp-board-rows" type="number" min="18" max="72" step="1" value="18" required disabled></label>
          </div>
          <button id="mp-board-save" type="submit" class="btn btn--small" disabled>Save board</button>
        </form>
        <p class="mp-config-status" id="mp-board-status" role="status" aria-live="polite"></p>
        <p class="mp-card__hint">The server locks this board for each match. Board changes apply to the next Brawl.</p>
      </section>
      <section class="mp-card mp-presentation-card" aria-labelledby="mp-presentation-title">
        <p class="mp-room__eyebrow" id="mp-presentation-host-label">Host controls · next Brawl</p>
        <h3 class="mp-card__title" id="mp-presentation-title">Brawl presentation</h3>
        <p class="mp-card__hint" id="mp-presentation-reason">Choose how this Brawl is presented. The server simulation and rules stay the same.</p>
        <form id="mp-presentation-form" class="mp-board-form">
          <label for="mp-presentation-choice">Presentation strategy</label>
          <select id="mp-presentation-choice" disabled>
            <option value="classic">Classic Brawl · fully server-synchronized</option>
            <option value="responsive">Responsive Brawl · instant local movement + smooth remote playback</option>
          </select>
          <button id="mp-presentation-save" type="submit" class="btn btn--small" disabled>Save presentation</button>
        </form>
        <p class="mp-config-status" id="mp-presentation-status" role="status" aria-live="polite"></p>
        <p class="mp-card__hint" id="mp-presentation-availability">Both strategies run the same authoritative Ruby simulation: same rules, same scores, same results. Classic paints each confirmed frame as it arrives. Responsive predicts your own snake locally and plays other players back smoothly from buffered confirmed movement.</p>
      </section>
    </div>

    <div class="mp-actions mp-actions--room">
      <button class="btn btn--primary" id="mp-ready-toggle" type="button">I'm ready</button>
      <button class="btn btn--primary" id="mp-start" type="button" hidden>Start Brawl</button>
      <button class="btn btn--primary" id="mp-again" type="button" hidden>Play again</button>
      <button class="btn btn--small btn--danger" id="mp-disband" type="button" hidden>Disband room</button>
      <button class="btn btn--small" id="mp-leave" type="button">Leave room</button>
    </div>

    <p class="mp-note" id="mp-host-note" hidden>
      Ready votes are advisory — as host, you decide when the Brawl begins.
    </p>
  </section>
</main>

<footer class="footer">
  <span>Next Level Snake — wall-wrap arcade</span>
  <span>Ruby on Rails <%= Rails.version %> · PostgreSQL · Puma · Podman/Docker</span>
  <span>Multiplayer · server-authoritative Brawls</span>
</footer>

<%# Confirmation before leaving a room you are already in (requirement 12). %>
<dialog class="dialog" id="mp-confirm" aria-labelledby="mp-confirm-title">
  <div class="dialog__inner">
    <div class="dialog__head">
      <h2 class="dialog__title" id="mp-confirm-title">Leave your current room?</h2>
      <button class="dialog__close" id="mp-confirm-close" type="button" aria-label="Close">✕</button>
    </div>
    <p class="mp-card__hint" id="mp-confirm-body">You are already in a room.</p>
    <div class="mp-actions">
      <button class="btn btn--primary" id="mp-confirm-ok" type="button">Leave and join</button>
      <button class="btn btn--small" id="mp-confirm-cancel" type="button">Stay here</button>
    </div>
  </div>
</dialog>

<%# Built-in QR scanner (step 5). Decoding runs entirely in this page — native
    BarcodeDetector when available, vendored jsQR otherwise — so no camera
    frame ever leaves the device. Every exit path (success, failure, cancel,
    Escape) releases the camera: see stopScanner() in lobby.js. %>
<dialog class="dialog mp-scan" id="mp-scan" aria-labelledby="mp-scan-title">
  <div class="dialog__inner">
    <div class="dialog__head">
      <h2 class="dialog__title" id="mp-scan-title">Scan an invitation QR code</h2>
      <button class="dialog__close" id="mp-scan-close" type="button" aria-label="Close">✕</button>
    </div>
    <div class="mp-scan__stage" id="mp-scan-stage" hidden>
      <video id="mp-scan-video" class="mp-scan__video" playsinline autoplay muted
             aria-label="Camera preview for scanning a QR code"></video>
      <div class="mp-scan__reticle" aria-hidden="true"></div>
    </div>
    <p class="mp-scan__status" id="mp-scan-status" role="status" aria-live="polite">Starting camera…</p>
    <p class="mp-card__hint">Decoded locally, on this device. Point the camera at a Next Level Snake invitation.</p>
    <div class="mp-actions">
      <button class="btn btn--small" id="mp-scan-cancel" type="button">Cancel scanning</button>
    </div>
  </div>
</dialog>

<%= render "shared/auth_dialog" %>

<% content_for :scripts do %>
  <%# Vendored open-source QR tooling (licenses alongside): qrcode-generator
      draws the invitation QR, jsQR is the decoder fallback. Classic scripts
      expose window.qrcode / window.jsQR to the module below; both work fully
      offline — nothing here phones home. %>
  <script src="/multiplayer/vendor/qrcode.min.js?v=2026-10-23.1"></script>
  <script src="/multiplayer/vendor/jsqr.min.js?v=2026-10-23.1"></script>
  <script type="module" src="/multiplayer/page.js?v=step10-mobile4"></script>
<% end %>
