<% content_for :title, "Profile — Next Level Snake" %>
<% skins = [["classic", "Classic"], ["arcade", "Arcade"], ["vintage", "Vintage"], ["terminal", "Terminal"], ["paper", "Paper"], ["violet", "Midnight Violet"], ["sunsetfire", "Royal Sunset"]] %>

<div class="page-texture" aria-hidden="true"></div>
<div class="page-scrim" aria-hidden="true"></div>
<canvas id="matrix-rain" class="matrix-rain" aria-hidden="true"></canvas>

<div class="spine" aria-hidden="true">
  <span>Next Level Snake <b>/</b> Player Profile</span>
</div>

<header class="masthead">
  <a class="masthead__brand" href="/" aria-label="Next Level Snake — back to the game">
    <span class="mark" aria-hidden="true"></span>
    <span class="brand__text">
      <span class="brand__eyebrow">Next Level</span>
      <span class="wordmark">Snake</span>
    </span>
  </a>
  <nav class="masthead__meta" aria-label="Main navigation">
    <a class="btn btn--small btn--nav" href="/">Play</a>
    <a class="btn btn--small btn--nav" href="/#leaderboard">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M6 2h12v2h4v4a5 5 0 0 1-5 5h-.5A6 6 0 0 1 13 15.9V18h3v4H8v-4h3v-2.1A6 6 0 0 1 7.5 13H7a5 5 0 0 1-5-5V4h4V2Zm-2 4v1a3 3 0 0 0 3 3V6H4Zm16 0h-3v4a3 3 0 0 0 3-3V6Z" /></svg>
      Leaderboard
    </a>
    <a class="btn btn--small btn--nav" href="/profile" aria-current="<%= @username.blank? ? "page" : "false" %>">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" shapeRendering="crispEdges" aria-hidden="true"><path d="M2 8h20v3H2Zm1 3h6v5H3v-5Zm13 0h6v5h-6v-5Z" /></svg>
      Profile
    </a>
    <a class="btn btn--small btn--nav" href="https://github.com/HelloJesusBeloved/next-level-snake" target="_blank" rel="noreferrer">
      <svg class="nav-icon" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.28-.01-1.04-.02-2.04-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.22.69.83.57A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12Z" /></svg>
      Open Source
    </a>
    <span class="auth-area" id="auth-out">
      <button class="btn btn--small" id="btn-open-login" type="button">Sign in</button>
      <button class="btn btn--small btn--primary" id="btn-open-create" type="button">Create account</button>
    </span>
    <span class="auth-area" id="auth-in" hidden>
      <span class="chip" id="auth-user"></span>
      <button class="btn btn--small btn--signout" id="btn-logout" type="button">Sign out</button>
    </span>
  </nav>
</header>

<%# public/profile.js loads GET /api/profile and draws everything in here. The theme panel stays hidden until a profile actually loads (never on the sign-in gate). %>
<main class="pf-layout is-gated">
  <aside class="pf-side" aria-label="Theme" hidden>
    <div class="card" id="pf-skin-card">
      <div class="card__head">
        <h2 class="card__title">Theme</h2>
        <span class="setting__value" id="pf-skin-value">Classic</span>
      </div>
      <div class="segmented" id="pf-skin-theme" role="group" aria-label="Theme">
        <% skins.each do |id, name| %>
          <button type="button" data-theme="<%= id %>" aria-pressed="<%= id == "classic" %>"><span class="swatch" data-swatch="<%= id %>"><i aria-hidden="true"></i><%= name %></span></button>
        <% end %>
      </div>
    </div>
  </aside>

  <div class="pf" id="profile-root" <% if @username.present? %>data-username="<%= @username %>"<% end %> aria-live="polite"></div>
</main>

<footer class="footer">
  <span>Next Level Snake — wall-wrap arcade</span>
  <span>Ruby on Rails <%= Rails.version %> · PostgreSQL · Puma · Podman/Docker</span>
  <span>Your games, your log</span>
</footer>

<dialog class="board-lightbox" id="board-lightbox" aria-labelledby="board-lightbox-title">
  <div class="board-lightbox__inner">
    <div class="board-lightbox__head">
      <h2 id="board-lightbox-title">Ending position</h2>
      <button class="dialog__close" id="board-lightbox-close" type="button" aria-label="Close enlarged board">✕</button>
    </div>
    <div class="board-lightbox__frame" id="board-lightbox-frame"></div>
    <p class="board-lightbox__cap" id="board-lightbox-cap"></p>
  </div>
</dialog>

<%= render "shared/auth_dialog" %>

<% content_for :scripts do %>
  <script src="/profile.js?v=2026-10-19.1"></script>
<% end %>
