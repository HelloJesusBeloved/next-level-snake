<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0c0e10">
    <title><%= content_for?(:title) ? yield(:title) : "Next Level Snake — Wall-Wrap Arcade" %></title>
    <meta name="description" content="Next Level Snake: one long green body, wrapping walls, red food. Preset or custom speed and growth, themes, accounts and public leaderboards.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="icon" href="/favicon.svg?v=2026-10-19.4" type="image/svg+xml">
    <link rel="alternate icon" href="/favicon.ico?v=2026-10-19.4">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2026-10-19.4">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png?v=2026-10-19.4">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2026-10-19.4">
    <link rel="stylesheet" href="/game.css?v=2026-10-19.4">
    <link rel="stylesheet" href="/styles.css?v=2026-10-19.4">
    <script>
      try {
        var __s = JSON.parse(localStorage.getItem('snake.settings.v1') || '{}');
        document.documentElement.setAttribute('data-theme', __s.theme || 'classic');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'classic');
      }
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Page-specific head tags (the multiplayer lobby's stylesheet). %>
    <%= yield :head if content_for?(:head) %>
  </head>
  <body>
    <%= yield %>
    <%# Terminal theme's Matrix rain — shared by the game page and the profile page. %>
    <script src="/rain.js?v=2026-10-19.4"></script>
    <% if content_for?(:scripts) %>
      <%= yield :scripts %>
    <% else %>
      <script src="/game.js?v=2026-10-19.4"></script>
      <script src="/app.js?v=2026-10-19.4"></script>
    <% end %>
  </body>
</html>
