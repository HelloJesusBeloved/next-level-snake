# Copy to rails/.env and edit. install.sh generates this file for you.
# Rails: https://edgeguides.rubyonrails.org/configuring.html

RAILS_ENV=production
RAILS_LOG_LEVEL=info
PORT=3000

# Generate with:  bin/rails secret
SECRET_KEY_BASE=

# PostgreSQL — either a full URL…
# DATABASE_URL=postgresql://snake:password@localhost:5432/snake_production
# …or discrete settings:
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=snake
DATABASE_PASSWORD=
DATABASE_NAME=snake_production

# Set to "true" when TLS terminates in front of Puma (nginx + certbot).
RAILS_FORCE_SSL=false

# Puma
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=0
