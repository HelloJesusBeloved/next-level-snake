# Native startup: podman compose up --build -d
# Docker is also supported: docker compose up --build -d
# The command chooses the engine. No engine-selector variable or wrapper.

# Required. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Published host address and port. Use 127.0.0.1 behind a local reverse proxy.
BIND_ADDRESS=0.0.0.0
PORT=3000

# Change before the FIRST start. An existing Postgres volume keeps its original
# user/password; editing these values later does not rotate database credentials.
DATABASE_USER=snake
DATABASE_PASSWORD=snake
DATABASE_NAME=snake_production

RAILS_LOG_LEVEL=info
RAILS_FORCE_SSL=false
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=0

# ---- Cloudflare Tunnel (optional) -------------------------------------------
# Publishes the game at a Cloudflare domain through an OUTBOUND-only connector:
# no router port-forward, no inbound firewall rule, free TLS at the edge.
# Full walkthrough: README "Expose it with a Cloudflare Tunnel".

# The on/off switch. Compose reads this variable from .env natively:
#   empty            -> tunnel disabled, stack runs exactly as before
#   COMPOSE_PROFILES=tunnel -> the cloudflared container starts too
# (Older podman-compose releases without profile support: run
#  `podman-compose --profile tunnel up -d` instead of setting this.)
COMPOSE_PROFILES=

# The tunnel token from the Cloudflare dashboard (Networks -> Tunnels -> your
# tunnel). REQUIRED when the tunnel profile is enabled; cloudflared exits with
# a clear error if the profile is on and this is empty. Treat it like a
# password - anyone holding it can serve traffic on your hostname.
CLOUDFLARE_TUNNEL_TOKEN=

# The public https origin players will use, e.g. https://snake.example.com
# Makes invitation links and QR codes point at the tunnel hostname instead of
# whatever LAN address the host sees. Leave empty when not using the tunnel.
MULTIPLAYER_PUBLIC_ORIGIN=

# Normally NOT needed: the /cable WebSocket is same-origin through the tunnel.
# Only set this (comma-separated origins) if a proxy in front rewrites Origin.
ACTION_CABLE_ALLOWED_ORIGINS=
